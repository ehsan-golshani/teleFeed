    {
      "id": 5834,
      "message": "\u003ctg-emoji emoji-id=\"5828025979334823630\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F94BA.png\u0026#39;)\"\u003e\u003cb\u003e🔺\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F8EA4.png\u0026#39;)\"\u003e\u003cb\u003e🎤\u003c/b\u003e\u003c/i\u003e مفاد تفاهم ایران و آمریکا؛ حل‌نشدنی یا شکننده؟\u003cbr/\u003e\u003cbr/\u003eگفت‌وگو با شایان سمیعی،‌ کارشناس امنیت ملی\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D8%AA%D9%88%D8%A7%D9%81%D9%82\"\u003e#توافق\u003c/a\u003e \u003ca href=\"?q=%23%D9%85%D8%B0%D8%A7%DA%A9%D8%B1%D8%A7%D8%AA\"\u003e#مذاکرات\u003c/a\u003e\u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
