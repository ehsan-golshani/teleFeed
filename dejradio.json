    {
      "id": 8257,
      "message": "\u003ctg-emoji emoji-id=\"4911490704376596665\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9191.png\u0026#39;)\"\u003e\u003cb\u003e👑\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e\u003ctg-emoji emoji-id=\"5213419616725903784\"\u003e\u003ci class=\"emoji\" style=\"background-image:url(\u0026#39;//telegram.org/img/emoji/40/F09F9AA8.png\u0026#39;)\"\u003e\u003cb\u003e🚨\u003c/b\u003e\u003c/i\u003e\u003c/tg-emoji\u003e  \u003cb\u003eهشدار دفتر شاهزاده رضا پهلوی؛ ایمیل‌های «ایران در ۲۰۳۵» جعلی است\u003c/b\u003e\u003cbr/\u003e\u003cbr/\u003eدفتر رسانه‌ای شاهزاده رضا پهلوی با انتشار اطلاعیه‌ای نسبت به ارسال ایمیل‌های جعلی با عنوان ساختگی «ایران در ۲۰۳۵» به شماری از افراد، فعالان و روزنامه‌نگاران هشدار داد. در این ایمیل‌ها، فرستندگان به‌دروغ خود را نماینده شاهزاده رضا پهلوی معرفی کرده‌اند.\u003cbr/\u003eبر اساس این اطلاعیه، هیچ تیم، پروژه یا ابتکار رسمی با عنوان «ایران در ۲۰۳۵» از سوی شاهزاده رضا پهلوی یا تیم ایشان تشکیل یا تأیید نشده و دعوت‌نامه‌هایی که با این عنوان برای یک گردهمایی خصوصی ارسال شده‌اند نیز جعلی و بدون مجوز هستند.\u003cbr/\u003eدفتر شاهزاده رضا پهلوی از دریافت‌کنندگان خواسته است به این ایمیل‌ها پاسخ ندهند، روی لینک‌های موجود کلیک نکنند، فایل‌های پیوست را باز نکنند و هیچ‌گونه اطلاعات شخصی، مالی یا حرفه‌ای در اختیار فرستندگان قرار ندهند.\u003cbr/\u003eدر این اطلاعیه همچنین تأکید شده است که تمامی دعوت‌نامه‌ها و مکاتبات رسمی شاهزاده رضا پهلوی و دفتر ایشان صرفاً از طریق کانال‌های رسمی و تأییدشده ارسال خواهد شد.\u003cbr/\u003e\u003cbr/\u003e\u003cbr/\u003e\u003ca href=\"?q=%23%D9%87%D8%B4%D8%AF%D8%A7%D8%B1\"\u003e#هشدار\u003c/a\u003e \u003ca href=\"?q=%23%D8%B4%D8%A7%D9%87%D8%B2%D8%A7%D8%AF%D9%87_%D8%B1%D8%B6%D8%A7_%D9%BE%D9%87%D9%84%D9%88%DB%8C\"\u003e#شاهزاده_رضا_پهلوی\u003c/a\u003e \u003cbr/\u003e\u003ca href=\"https://t.me/DEJradio\" target=\"_blank\"\u003e@DEJradio\u003c/a\u003e",
